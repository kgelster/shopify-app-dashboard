# Copy to .env and fill in. Everything above the first blank-line group is
# required: the app refuses to start without it.

DATABASE_URL=postgresql://localhost:5432/partner_dashboard

# Shopify Partner API. Create the token at
# partners.shopify.com/<org-id>/settings/partner_api_clients (note the slug is
# partner_api_clients, not api_clients). ORG_ID is the number in that URL.
PARTNER_API_TOKEN=
PARTNER_ORG_ID=
PARTNER_APP_ID=

# Basic auth pairs, "user:pass,user2:pass2". This is the curl and fallback path
# and works even when Google SSO is down or unconfigured.
#
# IT BYPASSES GOOGLE_ALLOWED_DOMAINS, so treat a pair here as full access.
# Generate the password, do not invent one, and note that a comma inside it
# would silently truncate it (the app refuses that rather than allowing it):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_USERS=

# Where this dashboard is reachable. Must match the Google OAuth redirect URI
# byte for byte, and is used for every link in the .md mirrors and Slack alerts.
PUBLIC_BASE_URL=http://localhost:8000

# Who may sign in with Google. Comma-separated; a bare domain admits everyone
# there, an entry containing "@" admits exactly that address. This is the only
# access gate -- the OAuth client is External, so Google authenticates anyone.
GOOGLE_ALLOWED_DOMAINS=example.com,someone@partner.example

# Signs the session cookie. GENERATE ONE, do not use a memorable string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This repository is public, so any placeholder committed here is known to
# everyone: a deployment running on one forges any session with no credential.
# The app refuses to start on a non-localhost PUBLIC_BASE_URL with fewer than
# 32 characters here. Rotating it signs everyone out, which is also how you
# revoke every session at once.
SESSION_SECRET=


# --- identity ---------------------------------------------------------------
# The app you are measuring. The dashboard titles itself "<APP_NAME> Analytics".
APP_NAME=Shopify App
# Optional. Used in export filenames; defaults to a slug of APP_NAME.
APP_SLUG=
# Optional. Your public App Store listing. The reviews link is hidden if unset.
APP_LISTING_URL=

# --- what your app sells ----------------------------------------------------
# AppSubscription has no billing-interval field, so annual plans are recognised
# by price. List every annual price you charge, comma separated, with cents:
#   ANNUAL_PLAN_AMOUNTS=190.00,1900.00
#
# EMPTY MEANS EVERY PLAN IS MONTHLY. An annual price missing here is counted at
# twelve times its true MRR, which is the easiest way to make this dashboard
# lie. Nothing on any page says so, and the annual-plan data invariant cannot
# catch it either: with no charge labelled annual it inspects zero rows and
# passes. The app logs a WARNING at startup when this is empty.
#
# Changing this later does NOT fix already-stored charges. A corrected price
# only reaches them on re-ingest, so follow it with a cursor reset and replay:
#   update sync_state set cursor = null where source = 'partner_api';
ANNUAL_PLAN_AMOUNTS=

# --- what your app does -----------------------------------------------------
# Accepted event names on POST /ingest/usage. See
# docs/usage-events-integration.md before changing these.
USAGE_EVENT_TYPES=offer_created,offer_impression,offer_conversion,settings_completed
USAGE_ACTIVATION_EVENT=offer_created
USAGE_LIVE_EVENT=offer_impression
# Shared secret your app sends as X-Usage-Token. Unset means the ingest
# endpoint refuses everything, which is the right default until the app is wired.
USAGE_INGEST_TOKEN=

# --- Google sign-in (optional; Basic auth works without it) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GA4 App Store listing traffic (optional) -------------------------------
# The Partner API exposes no listing traffic at all, so this is the only source
# for listing views, sources, and listing-to-install conversion. Unset means the
# Traffic page stays empty.
GA4_PROPERTY_ID=
# The service-account key JSON, whole, on one line.
GA4_CREDENTIALS_JSON=
# The day your property started collecting. Only affects the first backfill.
GA4_EARLIEST_DATA=2020-01-01

# --- Slack (optional) -------------------------------------------------------
# Stale-sync alerts and the weekly digest. Unset means neither is sent.
SLACK_WEBHOOK_URL=

# --- operational ------------------------------------------------------------
POLL_INTERVAL_MINUTES=15
POLL_OVERLAP_MINUTES=60

# Weekly digest schedule.
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR=9
DIGEST_TIMEZONE=UTC

# The header your proxy puts the real client address in. Rate limiting keys on
# it, so a wrong value collapses every caller into one bucket.
#
# Prefer a single-value header your proxy OVERWRITES: Fly-Client-IP,
# CF-Connecting-IP, X-Real-IP. X-Forwarded-For also works, but it is a list
# that proxies append to, so the leftmost entry is whatever the client sent;
# only the rightmost is trustworthy, and that is the one read here.
#
# Leave empty when nothing sits in front of the app.
TRUSTED_CLIENT_IP_HEADER=

# No chart annotation may be dated before this. Set it to roughly when your app
# launched.
ANNOTATIONS_EARLIEST=2020-01-01

# Shopify made the uninstall-reason question mandatory during 2026. Coverage
# either side is not comparable, so reports split on this date. Verify it
# against your own feed: it is the day after your last empty uninstall reason.
REASON_MANDATORY_FROM=2026-04-29

# Not a Settings field, read straight from the environment: set to 1 to skip
# starting the background scheduler. The test suite sets it.
NO_SCHEDULER=
